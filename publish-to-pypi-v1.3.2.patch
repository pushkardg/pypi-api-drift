diff --git a/.github/workflows/publish.yml b/.github/workflows/publish.yml
new file mode 100644
index 0000000..d16be0b
--- /dev/null
+++ b/.github/workflows/publish.yml
@@ -0,0 +1,57 @@
+name: publish
+# Builds the package and uploads it to PyPI when a GitHub release is published.
+# Uses PyPI trusted publishing: no API token is stored in the repository.
+# One-time setup on pypi.org: add a pending publisher for project "pypi-api-drift",
+# owner "pushkardg", repository "pypi-api-drift", workflow "publish.yml", environment "pypi".
+on:
+  release:
+    types: [published]
+  workflow_dispatch:   # manual run: builds and checks only, does not upload
+
+permissions:
+  contents: read
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - name: Release tag must match the package version
+        if: github.event_name == 'release'
+        run: |
+          v=$(python -c "import tomllib; print(tomllib.load(open('pyproject.toml','rb'))['project']['version'])")
+          tag="${GITHUB_REF_NAME#v}"
+          echo "pyproject version $v, release tag $GITHUB_REF_NAME"
+          test "$v" = "$tag" || { echo "::error::tag $GITHUB_REF_NAME does not match version $v in pyproject.toml"; exit 1; }
+      - run: python -m pip install build twine
+      - run: python -m build
+      - run: python -m twine check --strict dist/*
+      - name: Install the built wheel and run the tests against it
+        run: |
+          python -m venv /tmp/v
+          /tmp/v/bin/pip install dist/*.whl pytest
+          /tmp/v/bin/python -m pytest -q -p no:cacheprovider tests
+          /tmp/v/bin/apidrift-check --help > /dev/null
+      - uses: actions/upload-artifact@v4
+        with:
+          name: dist
+          path: dist/
+
+  pypi:
+    needs: build
+    if: github.event_name == 'release'
+    runs-on: ubuntu-latest
+    environment:
+      name: pypi
+      url: https://pypi.org/project/pypi-api-drift/
+    permissions:
+      id-token: write   # required for trusted publishing
+    steps:
+      - uses: actions/download-artifact@v4
+        with:
+          name: dist
+          path: dist/
+      - uses: pypa/gh-action-pypi-publish@release/v1
